# Postgres connection (AWS RDS in production)
DATABASE_URL=postgresql://user:password@localhost:5432/workout
# Only read by the tests (pytest)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/workout_test

# Comma separated list of allowed browser origins (web app)
CORS_ORIGINS=http://localhost:3000

# AWS Cognito user pool: the API accepts its ID tokens
COGNITO_REGION=eu-west-3
COGNITO_USER_POOL_ID=eu-west-3_XXXXXXXXX
# App client id of the mobile app (the `aud` claim of its ID tokens)
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Apple App Store (StoreKit 2 subscriptions, iOS)
APPLE_BUNDLE_ID=com.example.toa
# Numeric App Store app id (App Store Connect > App Information > Apple ID).
# Required to verify Production purchases; without it only Sandbox
# (TestFlight / Xcode) purchases are accepted.
APPLE_APP_ID=1234567890

# Stripe billing for the web app (2 EUR/month "remove ads" subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Used for Checkout / Customer Portal return URLs
FRONTEND_URL=http://localhost:3000
